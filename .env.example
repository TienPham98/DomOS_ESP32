# ==============================================================================
# DomOS — Environment Variables & Secrets Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual private tokens, keys, and URLs.
# WARNING: NEVER commit your active .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESP32-S3 Hardware & Network Configuration
# ------------------------------------------------------------------------------
DOMOS_HOST_IP=<HOST_IP>
ESP32_DEVICE_IP=<DEVICE_IP>
ESP32_GATEWAY_IP=<GATEWAY_IP>
ESP32_NETMASK=<NETWORK_MASK>
ESP32_PORT=80
ESP32_MAC_ADDRESS=<DEVICE_MAC>

# ------------------------------------------------------------------------------
# 2. OpenRouter Cloud Voice Gateway (backend-python)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DOMOS_DEBUG=False

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_TIMEOUT_SEC=60
STT_PROVIDER=google-web
STT_LANGUAGE=vi-VN
WAKE_STT_PROVIDER=google-web
WAKE_STT_TIMEOUT_SEC=3
STT_OPENROUTER_FALLBACK=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_SEC=30
LLM_PROVIDER_ORDER=openai,openrouter
TTS_PROVIDER=google
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_TIMEOUT_SEC=15
CONVERSATION_DB_PATH=data/conversations.db
CORE_BACKEND_URL=http://<HOST_IP>:8081

# Codex plan usage: LOCAL_ENABLED means the CLI runs on the gateway host (PC/cloud).
# Cloud: set AUTH_DIR=/data/codex-auth, CLI_PATH=/usr/local/bin/codex, configure
# PostgreSQL DATABASE_URL as a postgresql:// URI and store a private Fernet key
# in a gateway-only Northflank secret group. Complete device login in its console.
# Alternative: LOCAL_ENABLED=False and upload snapshots from a signed-in PC.
CODEX_USAGE_LOCAL_ENABLED=True
CODEX_CLI_PATH=codex
CODEX_USAGE_CACHE_PATH=data/codex_usage.json
CODEX_USAGE_TIMEZONE=Asia/Bangkok
CODEX_USAGE_REFRESH_SECONDS=60
CODEX_USAGE_STALE_SECONDS=900
CODEX_USAGE_SYNC_TOKEN=
CODEX_USAGE_SYNC_URL=https://voice.<YOUR_DOMAIN>
CODEX_USAGE_AUTH_DIR=
CODEX_USAGE_AUTH_ENCRYPTION_KEY=

# Manchester United fixture tracker (register a free football-data.org key)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_TEAM_ID=66
FOOTBALL_TEAM_NAME=Manchester United
FOOTBALL_TIMEZONE=Asia/Bangkok
FOOTBALL_CACHE_TTL_SECONDS=86400
FOOTBALL_CACHE_PATH=data/manchester_united_schedule.json
MANCHESTER_UNITED_BADGE_URL=<MANCHESTER_UNITED_BADGE_IMAGE_URL>

# ------------------------------------------------------------------------------
# 3. Core Backend Configuration (backend-go)
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8081

# PostgreSQL DSN (Falls back to SQLite if offline)
DATABASE_URL=host=localhost user=domos password=domos dbname=domos port=5432 sslmode=disable TimeZone=UTC

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRY_HOURS=72

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=domos-backend
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Web Dashboard Configuration (dashboard-next)
# ------------------------------------------------------------------------------
PUBLIC_BASE_URL=http://<HOST_IP>:8081
OPENROUTER_HTTP_REFERER=http://<HOST_IP>:3000
DOMOS_MQTT_URI=mqtt://<HOST_IP>:1883
DOMOS_AI_WS_URI=ws://<HOST_IP>:8000/api/v1/voice/stream
# Optional cloud overrides used by firmware builds. Keep actual deployment
# addresses and credentials only in the private .env file.
# Examples: wss://<CLOUD_MQTT_HOST>/mqtt, https://<CLOUD_VOICE_HOST>,
# wss://<CLOUD_VOICE_HOST>/api/v1/voice/stream. Leave blank for local hosting.
DOMOS_CLOUD_MQTT_URI=
DOMOS_CLOUD_AI_HTTP_BASE=
DOMOS_CLOUD_AI_WS_URI=
DOMOS_AI_AUTH_TOKEN=
DOMOS_MQTT_USERNAME=
DOMOS_MQTT_PASSWORD=
NEXT_PUBLIC_API_URL=http://<HOST_IP>:8081
NEXT_PUBLIC_AI_GATEWAY_URL=http://<HOST_IP>:8000
NEXT_PUBLIC_DEVICE_IP=<DEVICE_IP>
NEXT_PUBLIC_HOST_IP=<HOST_IP>
NEXT_PUBLIC_MQTT_URL=mqtt://<HOST_IP>:1883
